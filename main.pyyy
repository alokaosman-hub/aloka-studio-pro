import streamlit as st
import numpy as np
from PIL import Image, ImageOps, ImageEnhance, ImageFilter
import io

# ڕێکخستنی لاپەڕە بە زمانی کوردی
st.set_page_config(page_title="Aloka Image Studio Pro", layout="wide")

st.markdown("""
    <style>
    body, .main, .block-container { background-color: #0f1116; color: white; }
    h1, h2, h3, p { text-align: right; direction: rtl; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    .stButton > button {
        background: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%);
        color: black; font-weight: bold; border: none; padding: 10px 24px; width: 100%; border-radius: 8px;
    }
    .stSlider, .stSelectbox { direction: rtl; }
    </style>
""", unsafe_allow_html=True)

st.markdown("<h1 style='color: #00f2fe; text-align: center;'>🎨 ئەلۆکا ستۆدیۆ پرۆ</h1>", unsafe_allow_html=True)
st.markdown("<p style='text-align: center; color: #a0aec0;'>یەکەمین ستۆدیۆی کوردی پێشکەوتوو بۆ دەستکاری و فلتەرکردنی وێنەکانتان</p>", unsafe_allow_html=True)
st.write("---")

col_view, col_ctrl = st.columns([1.3, 1])

with col_ctrl:
    st.markdown("<h3 style='color: #4facfe;'>⚙️ کۆنترۆڵ و فلتەرەکان</h3>", unsafe_allow_html=True)
    uploaded_file = st.file_uploader("وێنەکەت لێرەدا باربکە...", type=["jpg", "jpeg", "png"])
    
    if uploaded_file:
        st.write("---")
        # بەشی فلتەرەکان
        filter_option = st.selectbox("شێوازی فلتەر هەڵبژێڕە:", 
                                     ["ڕەسەن (بێ فلتەر)", "ڕەش و سپی کلاسیک", "لێڵی شاهانە (Blur)", "تیژکردنەوەی وێنە (Sharpen)", "کۆنتراستی بەرز"])
        
        st.write("---")
        # بەشی ڕووناكی و ڕەنگ
        brightness = st.slider("💡 ڕووناكی وێنە", 0.0, 3.0, 1.0, 0.1)
        contrast = st.slider("🌗 کۆنتراست و تۆخی", 0.0, 3.0, 1.0, 0.1)
        sharpness = st.slider("✨ تیژی ڕەنگەکان", 0.0, 3.0, 1.0, 0.1)
        
        st.write("---")
        # بەشی وەرگێڕان و ئاڕاستە
        rotate_angle = st.slider("🔄 چەرخاندنی وێنە (پلە)", 0, 360, 0, 90)
        flip_h = st.checkbox("↔️ ئاوێنەکردنی ئاسۆیی")
        flip_v = st.checkbox("↕️ ئاوێنەکردنی ستوونی")

with col_view:
    st.markdown("<h3 style='color: #4facfe; text-align: center;'>🖼️ بینینی وێنە</h3>", unsafe_allow_html=True)
    if uploaded_file:
        # خوێندنەوەی وێنە
        img = Image.open(uploaded_file)
        
        # جێبەجێکردنی فلتەرەکان
        if filter_option == "ڕەش و سپی کلاسیک":
            img = ImageOps.grayscale(img)
        elif filter_option == "لێڵی شاهانە (Blur)":
            img = img.filter(ImageFilter.BLUR)
        elif filter_option == "تیژکردنەوەی وێنە (Sharpen)":
            img = img.filter(ImageFilter.SHARPEN)
        elif filter_option == "کۆنتراستی بەرز":
            img = ImageEnhance.Contrast(img).enhance(2.0)
            
        # جێبەجێکردنی دەستکارییەکان
        if brightness != 1.0:
            img = ImageEnhance.Brightness(img).enhance(brightness)
        if contrast != 1.0:
            img = ImageEnhance.Contrast(img).enhance(contrast)
        if sharpness != 1.0:
            img = ImageEnhance.Color(img).enhance(sharpness)
            
        # چەرخاندن و فلیپ
        if rotate_angle != 0:
            img = img.rotate(rotate_angle, expand=True)
        if flip_h:
            img = ImageOps.flip(img)
        if flip_v:
            img = ImageOps.mirror(img)
            
        # پیشاندانی وێنە
        st.image(img, use_container_width=True, caption="وێنەی دەستکاریکراو")
        
        # دوگمەی داگرتن
        buf = io.BytesIO()
        img.save(buf, format="PNG")
        byte_im = buf.getvalue()
        st.download_button(label="📥 داگرتنی وێنەی کۆتایی", data=byte_im, file_name="aloka_edited.png", mime="image/png")
    else:
        st.info("تکایە وێنەیەک باربکە بۆ ئەوەی ئامرازەکان چالاک ببن.")
